# Copy to `.env.local`, which is git-ignored:
#
#   cp .env.example .env.local
#
# These point at the local Supabase stack that `pnpm db:start` boots, and
# should stay that way. The hosted project holds real members' personal data.
#
# `pnpm db:start` prints both values; if yours differ, its output wins. The
# publishable key identifies the project and grants nothing on its own — row
# level security decides what the signed-in person may read.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
CRON_SECRET=""
SUPABASE_STORAGE_PURGE_SECRET_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# reCAPTCHA v3 protects access-request submissions. Create a separate key for
# localhost if you want to exercise it locally. With both values absent, local
# development bypasses the check; production fails closed.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Google Workspace needs no local configuration. It uses the production
# deployment identity. See docs/integrations.md.
#
# Slack uses a production Vercel Connect connector. Leave it unset locally.

# Leave Resend unset locally. Local email must never reach real recipients.
