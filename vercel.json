{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/cron/storage-purge",
      "schedule": "30 3 * * *"
    }
  ],
  "regions": ["arn1"]
}
